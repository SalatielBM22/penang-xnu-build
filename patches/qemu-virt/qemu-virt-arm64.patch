+/* SPDX-License-Identifier: MIT
+ * Experimental QEMU virt / Cortex-A76 platform for public XNU 11417.140.69.
+ * Source: apple-oss-distributions/xnu @ 43a90889846e00bfb5cf1d255cdc0a701a1e05a4.
+ * This describes the native ARM64 ABI, not Apple's arm64e/PAC ABI.
+ * No physical Qualcomm board, SMP or peripheral support is implied.
+ */
+#ifndef _PEXPERT_ARM64_QEMU_VIRT_H
+#define _PEXPERT_ARM64_QEMU_VIRT_H
+
+#if defined(__arm64e__) || defined(__ARM_FEATURE_PAUTH)
+#error QEMU_VIRT requires the native arm64 Cortex-A76 ABI
+#endif
+#if CPU_HAS_APPLE_PAC || HAS_PARAVIRTUALIZED_PAC || HAS_APPLE_PAC
+#error QEMU_VIRT does not implement the Apple PAC key contract
+#endif
+
+/* This development platform has architectural page permissions, without
+ * Apple's physical lockdown or protected page-table monitor hardware.
+ */
+#if defined(CONFIG_SPTM) || XNU_MONITOR || defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR)
+#error QEMU_VIRT has no Apple memory-protection monitor or KTRR/CTRR hardware
+#endif
+
+/* kalloc_type metadata is a security contract, including without PAC.
+ * Reject compatibility macros which replace the compiler's layout analysis.
+ */
+#if defined(XNU_KERNEL_PRIVATE) && !defined(ASSEMBLER) && !defined(__ASSEMBLER__)
+#if !__has_builtin(__builtin_xnu_type_signature) || \
+    !__has_builtin(__builtin_xnu_type_summary) || \
+    !__has_builtin(__builtin_xnu_types_compatible)
+#error QEMU_VIRT requires real XNU typed-allocation compiler builtins
+#endif
+#endif
+
+#define QEMU_VIRT                   1
+#define NO_MONITOR                  1
+#define NO_ECORE                    1
+#define MAX_CPUS                    1
+#define MAX_CPU_CLUSTERS             1
+#define MAX_L2_CLINE                 6
+#define CORE_NCTRS                   2
+#define USE_APPLEARMSMP              1
+#define NO_XNU_PLATFORM_ERROR_HANDLER 1
+
+#define __ARM_ARCH__                8
+#define __ARM_VMSA__                8
+#define __ARM_VFP__                 4
+#define __ARM_COHERENT_CACHE__       1
+#define __ARM_COHERENT_IO__          1
+#define __ARM_IC_NOALIAS_ICACHE__    1
+#define __ARM_DEBUG__               7
+#define __ARM_ENABLE_SWAP__         1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#define __ARM_PAN_AVAILABLE__       1
+#define __ARM_16K_PG__              1
+#define ARM_PARAMETERIZED_PMAP      1
+#define __ARM_MIXED_PAGE_SIZE__     1
+#define ARM_ARCH_TIMER
+#define HAS_GIC_V3                  1
+
+/* Architectural GICv3 definitions, matching the existing pe_fiq.c driver. */
+#define GIC_SPURIOUS_IRQ             1023
+#define GICR_PE_SIZE                 0x20000
+#define GICD_CTLR                    0x0
+#define GICD_CTLR_ENABLEGRP0          0x1
+#define GICR_TYPER                   0x08
+#define GICR_WAKER                   0x14
+#define GICR_IGROUPR0                0x10080
+#define GICR_ISENABLER0              0x10100
+#define GICR_TYPER_AFFINITY_VALUE_SHIFT 32
+#define GICR_TYPER_LAST              0x10
+#define GICR_WAKER_PROCESSORSLEEP    0x2
+#define GICR_WAKER_CHILDRENASLEEP    0x4
+#define ICC_CTLR_EOIMODE             0x1
+#define ICC_SRE_SRE                  0x1
+
+#ifndef ASSEMBLER
+#define PL011_UART
+#endif
+#endif
